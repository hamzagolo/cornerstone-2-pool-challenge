# Optional shared access code. Leave blank to allow anyone with the link.
ACCESS_CODE=
PORT=3001

# Web Push (generate once with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# On Render, point this to a file on a mounted persistent disk, e.g. /var/data/push-subscriptions.json
PUSH_SUBSCRIPTIONS_FILE=./server/push-subscriptions.json
